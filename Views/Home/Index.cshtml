@model IndexViewModel
@{
    ViewData["Title"] = "Home | AAD SSO Demo";
    var cacheToken = (string?)(ViewBag.CacheToken) ?? string.Empty;
    var msalUserName = Model.MsalUser.GetValueOrDefault("name");
    if (string.IsNullOrWhiteSpace(msalUserName))
    {
        msalUserName = Model.MsalUser.GetValueOrDefault("preferred_username");
    }

    var easyAuthName = Model.EasyAuthUser.TryGetValue("name", out var easyName) ? easyName?.ToString() : string.Empty;
    if (string.IsNullOrWhiteSpace(easyAuthName) && Model.EasyAuthUser.TryGetValue("preferred_username", out var easyPrincipal))
    {
        easyAuthName = easyPrincipal?.ToString();
    }
}
<span class="section-kicker" data-i18n="identity.kicker">Identity Demo</span>
<h1 data-i18n="identity.title">.NET demo with MS Entra ID SSO</h1>
<p data-i18n="identity.intro">
    This sample supports two sign-in modes on one site: Dotnet/MSAL (app-managed) and
    App Service Easy Auth (platform-managed).
</p>

<div class="mode-grid">
    <div class="mode-option">
        <div class="mode-card msal">
            <h3 data-i18n="mode.msal">MSAL Mode</h3>
            <p data-i18n="mode.msal.description">The ASP.NET Core app uses MSAL to initiate sign-in, process the authorization response, acquire tokens, and maintain the authenticated user session in application code.</p>
            <div class="mode-diagram">
                <img src="@($"{Url.Content("~/img/msal-flow.svg")}?v={cacheToken}")" alt="MSAL authentication flow diagram">
            </div>
        </div>
        <a class="button primary mode-signin-button" href="@Url.Action("LoginMsal", "Home")" data-i18n="signin.msal">Sign in with MSAL</a>
    </div>
    <div class="mode-option">
        <div class="mode-card easy-auth">
            <h3 data-i18n="mode.easy">Easy Auth Mode</h3>
            <p data-i18n="mode.easy.description">Azure App Service authenticates the user before the request reaches ASP.NET Core, then provides verified identity details through platform-managed headers.</p>
            <div class="mode-diagram">
                <img src="@($"{Url.Content("~/img/easy-auth-flow.svg")}?v={cacheToken}")" alt="Easy Auth authentication flow diagram">
            </div>
        </div>
        <a class="button secondary mode-signin-button" href="@Url.Action("LoginEasyAuth", "Home")" data-i18n="signin.easy">Sign in with Easy Auth</a>
    </div>
</div>

@if (Model.MsalUser.Count > 0)
{
    <p>
        MSAL session active for
        <strong>@msalUserName</strong>.
    </p>
    <div class="actions">
        <a class="button primary" href="@Url.Action("ProfileMsal", "Home")">View MSAL profile</a>
        <a class="button secondary" href="@Url.Action("LogoutMsal", "Home")">Sign out (MSAL)</a>
    </div>
}

@if (Model.EasyAuthUser.Count > 0)
{
    <p>
        Easy Auth session active for
        <strong>@easyAuthName</strong>.
    </p>
    <div class="actions">
        <a class="button primary" href="@Url.Action("ProfileEasyAuth", "Home")">View Easy Auth profile</a>
        <a class="button secondary" href="@Url.Action("LogoutEasyAuth", "Home")">Sign out (Easy Auth)</a>
    </div>
}

@if (Model.MsalUser.Count == 0 && Model.EasyAuthUser.Count == 0)
{
    <p data-i18n="signin.choose">Choose an authentication mode to start sign-in.</p>
}
