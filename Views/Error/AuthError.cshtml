@model AuthErrorViewModel
@{
    ViewData["Title"] = "Authentication Error";
}
<h1 data-i18n="error.title">Authentication failed</h1>
<p><strong>@Model.Error</strong></p>
<p>@Model.ErrorDescription</p>

<div class="actions">
    <a class="button secondary" href="@Url.Action("Index", "Home")" data-i18n="action.backHome">Back home</a>
</div>
